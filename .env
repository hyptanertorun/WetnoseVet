# Database
MONGO_URL=mongodb://localhost:27017
DB_NAME=wetnose_db

# JWT Secrets (CHANGE IN PRODUCTION)
JWT_SECRET=wetnose-super-secret-key-change-in-production-2024
JWT_REFRESH_SECRET=wetnose-refresh-secret-key-change-in-production-2024

# App Environment (preview/production)
APP_ENV=preview

# Stage Admin (for preview environment only)
STAGE_ADMIN_EMAIL=admin@wetnose.com.tr
STAGE_ADMIN_PASSWORD=WetnoseStage2026!

# Support Admin (hidden admin not in database)
# SUPPORT_ADMIN_EMAIL=
# SUPPORT_ADMIN_PASSWORD=

# Initial Admin (for production)
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=

# Cookie Settings
COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Uploads
UPLOAD_DIR=/app/storage/uploads

# AI Features (optional)
# OPENAI_API_KEY=
# EMERGENT_LLM_KEY=

# Backend URL (for server-side API calls)
INTERNAL_API_URL=http://localhost:3000
# NEXT_PUBLIC_BACKEND_URL=
